						currentQuery = new Query_File();
						currentQuery.ID = line.substring(3);
					}
				} else if (line.startsWith(".W")) {
					currentSection = "query";	
				} else if (currentQuery != null && currentSection != null) {
					line = line.replace("?", "\\?");
					switch (currentSection) {
					case "query":						
						currentQuery.query += line.trim() + " ";
